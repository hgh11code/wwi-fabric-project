table fact_invoice_line
	lineageTag: d649f1fb-0ae9-40fe-880c-a7a1ce564f5b
	sourceLineageTag: [sales].[fact_invoice_line]

	measure 'Total Profit' =
			
			SUM(fact_invoice_line[line_profit])
		lineageTag: 636236ec-afa1-4108-84c7-bbe70cc236e4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales' =
			
			SUM(fact_invoice_line[sales_amount_incl_tax])
		lineageTag: ee9a9d6a-4790-4d4b-a730-3a9862701dba

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Excluding Tax' =
			
			SUM(fact_invoice_line[sales_amount_excl_tax])
		lineageTag: aca4254f-b350-4d44-afa3-6797f8dc3464

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quantity Sold' =
			
			SUM(fact_invoice_line[quantity])
		formatString: 0
		lineageTag: ed4edff5-e3de-42f4-a9f7-8cf9037a059a

		changedProperty = Name

	measure 'Invoice Count' =
			
			DISTINCTCOUNT(fact_invoice_line[invoice_id])
		formatString: 0
		lineageTag: ea0fb540-cf9c-47da-8ca3-dd3b0d57477d

		changedProperty = Name

	measure 'Profit Margin %' =
			
			DIVIDE(
			    [Total Profit],
			    [Sales Excluding Tax],
			    0
			)
		lineageTag: a195abbf-cc32-475f-a93a-d7ea1219f570

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

